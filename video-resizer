#!/usr/bin/env python3
"""
Batch Video Resizer - Process all videos in a directory to reduce file size.

Output goes to RESIZED_VIDEOS subfolder.
Cross-platform: works on Windows, macOS, and Linux.
"""

import os
import queue
import shutil
import subprocess
import threading
import tkinter as tk
from datetime import datetime
from pathlib import Path
from tkinter import messagebox, ttk


VIDEO_EXTENSIONS = {
    '.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv', '.webm',
    '.m4v', '.mpg', '.mpeg', '.3gp', '.ogv', '.ts'
}


def find_program(name):
    """Return the executable path, or None if it is not on PATH."""
    return shutil.which(name)


def get_video_duration(filepath):
    """Return video duration in seconds, or 0 if it cannot be read."""
    cmd = [
        find_program('ffprobe') or 'ffprobe',
        '-v', 'error',
        '-show_entries', 'format=duration',
        '-of', 'default=noprint_wrappers=1:nokey=1',
        str(filepath),
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=True, timeout=30
        )
        return float(result.stdout.strip())
    except (subprocess.SubprocessError, ValueError, OSError):
        return 0.0


def get_file_size(filepath):
    """Get file size in MB."""
    try:
        return Path(filepath).stat().st_size / (1024 * 1024)
    except OSError:
        return 0


def has_audio_stream(filepath):
    """Return True if the input contains at least one audio stream."""
    cmd = [
        find_program('ffprobe') or 'ffprobe',
        '-v', 'error',
        '-select_streams', 'a',
        '-show_entries', 'stream=codec_type',
        '-of', 'csv=p=0',
        str(filepath),
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=True, timeout=10
        )
        return bool(result.stdout.strip())
    except (subprocess.SubprocessError, OSError):
        return False


def get_video_bitrate(filepath):
    """Get total video bitrate."""
    try:
        r = subprocess.run(
            [
                find_program('ffprobe') or 'ffprobe',
                '-v', 'error',
                '-show_entries', 'stream=bit_rate,codec_type',
                '-of', 'csv=p=0',
                str(filepath),
            ],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if r.returncode == 0 and r.stdout.strip():
            return sum(
                int(line.split(',')[0])
                for line in r.stdout.strip().split('\n')
            )
        return 5_000_000  # default 5 Mbps
    except Exception:
        return 5_000_000


def estimate_output_size(filepath, quality):
    """Estimate output file size based on quality setting."""
    qmap = {
        'Smallest': 0.42,
        'Compact': 0.88,
        'Balanced': 1.09,
        'Good': 1.25,
    }
    multiplier = qmap.get(quality, 0.42)
    bitrate = get_video_bitrate(filepath)
    duration = get_video_duration(filepath)
    est_bytes = bitrate * duration / 8 * multiplier
    return est_bytes / (1024 * 1024)


def compress_video(input_path, output_path, quality):
    """Compress a single video to reduce file size."""
    ffmpeg = find_program('ffmpeg')
    if not ffmpeg:
        raise RuntimeError(
            'FFmpeg was not found.\n\n'
            'Install FFmpeg and make sure it is available in PATH.'
        )

    input_path = str(input_path)
    output_path = str(output_path)

    has_audio = has_audio_stream(input_path)

    qmap = {
        'Smallest': {'preset': 'veryfast', 'crf': '30', 'ab': '64k'},
        'Compact':  {'preset': 'fast',     'crf': '26', 'ab': '96k'},
        'Balanced': {'preset': 'medium',   'crf': '24', 'ab': '128k'},
        'Good':     {'preset': 'slower',   'crf': '22', 'ab': '128k'},
    }

    q = qmap[quality]

    cmd = [
        ffmpeg,
        '-y',
        '-i', input_path,
        '-c:v', 'libx264',
        '-preset', q['preset'],
        '-crf', q['crf'],
    ]

    if has_audio:
        cmd.extend(['-c:a', 'aac', '-b:a', q['ab']])
    else:
        cmd.append('-an')

    cmd.extend(['-movflags', '+faststart', output_path])

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        details = (result.stderr or result.stdout or 'Unknown error').strip()
        raise RuntimeError(f'FFmpeg could not process this video:\n\n{details[-3000:]}')

    return True


def get_desktop_directory():
    """Return the usual Desktop directory, falling back to the home folder."""
    home = Path.home()
    desktop = home / 'Desktop'
    return desktop if desktop.is_dir() else home


class FileBrowserPanel(ttk.Frame):
    """A simple cross-platform file browser."""

    def __init__(self, parent, on_select=None):
        super().__init__(parent, padding=5)
        self.on_select = on_select
        self.current_dir = Path.home()
        self.last_browsed_dir = Path.home()
        self.item_paths = {}
        self._build_ui()
        self._refresh()

    def _build_ui(self):
        nav = ttk.Frame(self)
        nav.pack(fill='x')

        ttk.Button(nav, text='↑ Up', command=self._go_up, width=6).pack(
            side='left', padx=1
        )
        ttk.Button(nav, text='Home', command=self._go_home, width=6).pack(
            side='left', padx=1
        )
        ttk.Button(
            nav, text='Desktop',
            command=lambda: self._navigate(get_desktop_directory()), width=8
        ).pack(side='left', padx=1)

        self.path_var = tk.StringVar(value=str(self.current_dir))
        ttk.Entry(nav, textvariable=self.path_var).pack(
            side='left', fill='x', expand=True, padx=3
        )
        ttk.Button(nav, text='Go', command=self._go_click, width=4).pack(
            side='left'
        )

        ttk.Label(nav, text='Filter:').pack(side='right', padx=(5, 2))
        self.filter_var = tk.StringVar()
        self.filter_var.trace_add('write', lambda *_: self._refresh())
        ttk.Entry(nav, textvariable=self.filter_var, width=15).pack(side='right')

        quick = ttk.Frame(self)
        quick.pack(fill='x')
        ttk.Label(quick, text='Quick:').pack(side='left')
        for label, folder in (
            ('Home', Path.home()),
            ('Videos', Path.home() / 'Videos'),
            ('Downloads', Path.home() / 'Downloads'),
        ):
            ttk.Button(
                quick, text=label,
                command=lambda p=folder: self._navigate(p), width=9
            ).pack(side='left', padx=1)

        tree_frame = ttk.Frame(self)
        tree_frame.pack(fill='both', expand=True, pady=3)

        vertical = ttk.Scrollbar(tree_frame)
        vertical.pack(side='right', fill='y')
        horizontal = ttk.Scrollbar(tree_frame, orient='horizontal')
        horizontal.pack(side='bottom', fill='x')

        # Include "name" as a real column.
        self.tree = ttk.Treeview(
            tree_frame,
            columns=('name', 'size', 'modified'),
            show='headings',
            yscrollcommand=vertical.set,
            xscrollcommand=horizontal.set,
            height=14,
        )
        self.tree.pack(fill='both', expand=True)
        vertical.config(command=self.tree.yview)
        horizontal.config(command=self.tree.xview)

        self.tree.heading('name', text='Name', anchor='w')
        self.tree.heading('size', text='Size', anchor='e')
        self.tree.heading('modified', text='Modified', anchor='w')
        self.tree.column('name', width=440, minwidth=180, anchor='w')
        self.tree.column('size', width=100, anchor='e')
        self.tree.column('modified', width=160, anchor='w')

        self.tree.bind('<Double-1>', self._on_double)
        self.tree.bind('<Return>', self._on_double)

        self.status = ttk.Label(self, text='Ready')
        self.status.pack(fill='x', pady=(2, 0))

    def _refresh(self):
        self.tree.delete(*self.tree.get_children())
        self.item_paths.clear()

        if not self.current_dir.is_dir():
            self.current_dir = Path.home()

        self.path_var.set(str(self.current_dir))
        filter_text = self.filter_var.get().strip().casefold()

        try:
            directories = []
            files = []

            with os.scandir(self.current_dir) as entries:
                for entry in entries:
                    if entry.name.startswith('.'):
                        continue
                    if filter_text and filter_text not in entry.name.casefold():
                        continue
                    try:
                        if entry.is_dir(follow_symlinks=False):
                            directories.append(entry)
                        else:
                            files.append(entry)
                    except OSError:
                        continue

            directories.sort(key=lambda item: item.name.casefold())
            files.sort(key=lambda item: item.name.casefold())

            for entry in directories + files:
                path = Path(entry.path)
                is_dir = entry.is_dir(follow_symlinks=False)

                if is_dir:
                    display_name = f'[Folder] {entry.name}'
                    size_text = '—'
                    modified_text = '—'
                else:
                    extension = path.suffix.lower()
                    prefix = '[Video] ' if extension in VIDEO_EXTENSIONS else ''
                    display_name = prefix + entry.name
                    try:
                        stat = entry.stat()
                        size_text = f'{stat.st_size / (1024 * 1024):.1f} MB'
                        modified_text = datetime.fromtimestamp(
                            stat.st_mtime
                        ).strftime('%Y-%m-%d %H:%M')
                    except OSError:
                        size_text = '?'
                        modified_text = '?'

                item_id = self.tree.insert(
                    '', 'end',
                    values=(display_name, size_text, modified_text)
                )
                self.item_paths[item_id] = path

            total = len(directories) + len(files)
            self.status.config(text=f'{total} items  |  {self.current_dir}')

        except (PermissionError, OSError) as error:
            self.status.config(text=f'Cannot read folder: {error}')

    def _on_double(self, _event=None):
        selection = self.tree.selection()
        if not selection:
            return

        path = self.item_paths.get(selection[0])
        if not path:
            return

        if path.is_dir():
            self._navigate(path)
        elif path.suffix.lower() in VIDEO_EXTENSIONS:
            if self.on_select:
                self.on_select(path)

    def _navigate(self, path):
        # expanduser handles typed paths such as ~/Videos on Unix-like systems.
        candidate = Path(os.path.expandvars(os.path.expanduser(str(path))))
        if candidate.is_dir():
            self.current_dir = candidate.resolve()
            self._refresh()
        else:
            messagebox.showwarning(
                'Folder not found', f'This folder does not exist:\n{candidate}'
            )

    def _go_up(self):
        parent = self.current_dir.parent
        if parent != self.current_dir:
            self._navigate(parent)

    def _go_home(self):
        self._navigate(Path.home())

    def _go_click(self):
        value = self.path_var.get().strip()
        if value:
            self._navigate(value)


class DirectoryChooser(tk.Toplevel):
    """Single-column folder picker. Shows folders only, hides dot-folders."""

    def __init__(self, parent, start_dir=None, title='Select Source Directory'):
        super().__init__(parent)
        self.title(title)
        self.geometry('560x520')
        self.transient(parent)
        self.result = None

        if start_dir and Path(start_dir).is_dir():
            self.current_dir = Path(start_dir).resolve()
        else:
            self.current_dir = Path.home()

        self._build_ui()
        self._refresh()
        self.grab_set()
        self.focus_set()

    def _build_ui(self):
        frame = ttk.Frame(self, padding=8)
        frame.pack(fill='both', expand=True)

        # Navigation row
        nav = ttk.Frame(frame)
        nav.pack(fill='x')
        ttk.Button(nav, text='↑ Up', width=6, command=self._go_up).pack(
            side='left', padx=1
        )
        ttk.Button(nav, text='Home', width=6, command=lambda: self._navigate(
            Path.home()
        )).pack(side='left', padx=1)
        self.path_var = tk.StringVar()
        entry = ttk.Entry(nav, textvariable=self.path_var)
        entry.pack(side='left', fill='x', expand=True, padx=3)
        entry.bind('<Return>', lambda e: self._navigate(
            self.path_var.get()
        ))
        ttk.Button(nav, text='Go', width=4, command=lambda: self._navigate(
            self.path_var.get()
        )).pack(side='left')

        # Quick-access row
        qa = ttk.Frame(frame)
        qa.pack(fill='x', pady=(3, 0))
        ttk.Label(qa, text='Quick:').pack(side='left')
        for label, path in [
            ('Home', Path.home()),
            ('Videos', Path.home() / 'Videos'),
            ('Downloads', Path.home() / 'Downloads'),
        ]:
            ttk.Button(
                qa, text=label, width=9,
                command=lambda p=path: self._navigate(p)
            ).pack(side='left', padx=1)

        # Single-column folder list
        tree_frame = ttk.Frame(frame)
        tree_frame.pack(fill='both', expand=True, pady=6)
        vs = ttk.Scrollbar(tree_frame)
        vs.pack(side='right', fill='y')
        self.tree = ttk.Treeview(
            tree_frame, show='tree', selectmode='browse',
            yscrollcommand=vs.set
        )
        self.tree.pack(side='left', fill='both', expand=True)
        vs.config(command=self.tree.yview)
        self.tree.bind('<Double-1>', self._on_double)
        self.tree.bind('<Return>', self._on_double)

        self.status = ttk.Label(frame, text='')
        self.status.pack(fill='x')

        # Buttons
        btns = ttk.Frame(frame)
        btns.pack(fill='x', pady=(6, 0))
        ttk.Button(btns, text='Cancel', command=self.destroy).pack(
            side='right', padx=3
        )
        ttk.Button(btns, text='Select This Folder', command=self._select).pack(
            side='right', padx=3
        )

    def _refresh(self):
        self.tree.delete(*self.tree.get_children())
        self.path_var.set(str(self.current_dir))

        try:
            folders = []
            for entry in os.scandir(self.current_dir):
                if entry.name.startswith('.'):
                    continue  # hide hidden folders
                try:
                    if entry.is_dir():  # follows symlinks (handy for mounts)
                        folders.append(entry)
                except OSError:
                    continue
            folders.sort(key=lambda e: e.name.casefold())

            for e in folders:
                self.tree.insert('', 'end', iid=e.path, text=f'📁 {e.name}')
            self.status.config(text=f'{len(folders)} folder(s)')
        except PermissionError:
            self.status.config(text='Permission denied')
        except OSError as ex:
            self.status.config(text=f'Error: {ex}')

    def _navigate(self, path):
        candidate = Path(os.path.expandvars(os.path.expanduser(str(path))))
        if candidate.is_dir():
            self.current_dir = candidate.resolve()
            self._refresh()
        else:
            messagebox.showwarning(
                'Folder not found', f'This folder does not exist:\n{candidate}'
            )

    def _go_up(self):
        parent = self.current_dir.parent
        if parent != self.current_dir:
            self._navigate(parent)

    def _on_double(self, event=None):
        sel = self.tree.selection()
        if sel:
            self._navigate(sel[0])

    def _select(self):
        self.result = self.current_dir
        self.destroy()


