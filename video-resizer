    def browse_source(self):
        """Browse for source directory."""
        start = self.source_dir.get().strip()
        if not start:
            start = str(Path.home() / 'Videos')
        dlg = DirectoryChooser(self.root, start_dir=start)
        self.root.wait_window(dlg)
        path = dlg.result
        if path:
            self.source_dir.set(str(path))
            self.output_dir.set(str(path))
            self.scan_directory()

    def scan_directory(self):
        """Scan the source directory for video files."""
        source = Path(self.source_dir.get().strip())
        if not source or not source.is_dir():
            messagebox.showerror('Error', 'Please select a valid directory.')
            return

        # Update output path
        self.output_dir.set(str(source))

        # Clear and populate
        for item in self.list_tree.get_children():
            self.list_tree.delete(item)

        self.video_list = []
        quality = self.quality_var.get()
        recursive = self.include_subdirs.get()

        videos = []
        if recursive:
            # Walk subdirectories recursively
            for dirpath, dirnames, filenames in os.walk(source):
                # Skip hidden directories
                dirnames[:] = [d for d in dirnames if not d.startswith('.')]
                dirnames.sort(key=str.casefold)
                for f in filenames:
                    if f.startswith('.'):
                        continue
                    ext = Path(f).suffix.lower()
                    if ext in VIDEO_EXTENSIONS:
                        full = Path(dirpath) / f
                        if full.is_file():
                            rel = full.relative_to(source)
                            display = str(rel)
                            size = get_file_size(full)
                            est = estimate_output_size(full, quality)
                            videos.append((display, full, size, est, 'Pending'))
        else:
            for f in source.iterdir():
                if f.name.startswith('.'):
                    continue
                ext = f.suffix.lower()
                if ext in VIDEO_EXTENSIONS and f.is_file():
                    size = get_file_size(f)
                    est = estimate_output_size(f, quality)
                    videos.append((f.name, f, size, est, 'Pending'))

        # Sort by display name
        videos.sort(key=lambda x: x[0].casefold())

        self.video_selectors = {}
        selected_count = len(videos) if self.select_all_var.get() else 0

        for display, full, orig, est, status in videos:
            self.video_list.append(full)
            var = tk.BooleanVar(value=self.select_all_var.get())
            item_id = self.list_tree.insert('', 'end', values=(
                '✓', display, f'{orig:.0f} MB', f'{est:.0f} MB', status
            ), text=display)
            self.video_selectors[item_id] = var

        self._update_selected_count(len(videos), selected_count)
        sub_note = ' (recursive)' if recursive else ''
        self.summary.config(text=f'Found {len(videos)} video(s){sub_note}')

    def _toggle_all(self):
        """Toggle all checkboxes."""
        state = self.select_all_var.get()
        for var in self.video_selectors.values():
            var.set(state)
        selected = sum(1 for v in self.video_selectors.values() if v.get())
        self._update_selected_count(len(self.video_selectors), selected)
        for item_id, var in self.video_selectors.items():
            status = '✓' if var.get() else ' '
            self.list_tree.set(item_id, 'select', status)

    def _on_tree_click(self, event):
        """Toggle checkbox when clicking a row."""
        region = self.list_tree.identify_region(event.x, event.y)
        if region == 'heading':
            return  # handled by heading command
        if region not in ('cell', ''):
            return

        item_id = self.list_tree.identify_row(event.y)
        if not item_id or item_id not in self.video_selectors:
            return

        var = self.video_selectors[item_id]
        var.set(not var.get())
        status = '✓' if var.get() else ' '
        self.list_tree.set(item_id, 'select', status)

        # Update background color
        if var.get():
            self.list_tree.item(item_id, tags=('selected',))
        else:
            self.list_tree.item(item_id, tags=())

        selected = sum(1 for v in self.video_selectors.values() if v.get())
        self._update_selected_count(len(self.video_selectors), selected)

    def _update_selected_count(self, total, selected):
        """Update the selected count label."""
        if total == 0:
            self.selected_count.config(text='')
        else:
            self.selected_count.config(text=f'{selected}/{total} selected')

    def resize_selected(self):
        """Start batch resize of selected videos only."""
        # Build list of selected paths
        selected = []
        for item_id, var in self.video_selectors.items():
            if var.get():
                idx = list(self.video_selectors.keys()).index(item_id)
                selected.append(self.video_list[idx])

        if not selected:
            messagebox.showerror(
                'Error',
                'No videos selected. Check the boxes to select videos to resize.'
            )
            return

        if self.processing:
            messagebox.showinfo(
                'Info', 'Already processing. Wait for it to finish.'
            )
            return

        reply = messagebox.askyesno(
            'Confirm',
            f'Resize {len(selected)} video(s)?\n\n'
            f'Source: {self.source_dir.get()}\n'
            f'Output: {self.output_dir.get()}\n'
            f'Quality: {self.quality_var.get()}\n'
            f"{'(recursive)' if self.include_subdirs.get() else ''}\n\n"
            f'This will take several minutes. Original files are NOT modified.'
        )
        if not reply:
            return

        self.processing = True
        self.scan_button.config(state='disabled')
        self.resize_button.config(state='disabled')
        self.reset_button.config(state='disabled')
        self.progress.start(12)
        self.progress_label.config(text='Processing videos…')
        self.summary.config(text='')

        worker = threading.Thread(
            target=self._resize_worker,
            args=(selected,),
            daemon=True,
        )
        worker.start()
        self.root.after(100, self._check_resize_result)

    def _resize_worker(self, selected):
        """Worker thread for batch resize."""
        try:
            # Resized files go in the same folder as the original

            quality = self.quality_var.get()
            total = len(selected)
            success = 0
            failed = 0
            saved_bytes = 0

            for i, video_path in enumerate(selected):
                filename = video_path.name
                name_no_ext = video_path.stem
                ext = video_path.suffix

                # Place resized file in same folder as original
                out_path = video_path.with_name(f'{name_no_ext}_resized{ext}')

                self.root.after(
                    0,
                    self._update_progress,
                    i + 1,
                    total,
                    filename,
                    'Processing...',
                )

                try:
                    orig_size = get_file_size(video_path)
                    compress_video(video_path, out_path, quality)
                    new_size = get_file_size(out_path)
                    saved = orig_size - new_size
                    saved_bytes += saved

                    self.root.after(
                        0,
                        self._update_progress,
                        i + 1,
                        total,
                        filename,
                        f'✓ {saved:.0f} MB saved',
                        f'{new_size:.0f} MB',
                    )
                    success += 1

                except Exception as e:
                    self.root.after(
                        0,
                        self._update_progress,
                        i + 1,
                        total,
                        filename,
                        f'✗ Error',
                    )
                    failed += 1

            self.result_queue.put(
                ('success', success, failed, saved_bytes, self.source_dir.get())
            )
        except Exception as e:
            self.result_queue.put(('error', 0, 0, 0, str(e)))

    def _update_progress(self, index, total, filename, status, est=''):
        """Update progress and tree from worker thread."""
        self.progress_label.config(text=f'Processing {index}/{total}: {filename}')
        self.progress['value'] = (index / total) * 100

        # Update tree status
        idx = self._find_item_by_path(filename)
        if idx:
            self.list_tree.set(idx, 'status', status)
            if est:
                self.list_tree.set(idx, 'est', est)
            self.list_tree.see(idx)

    def _check_resize_result(self):
        """Check worker result from UI thread."""
        try:
            status, success, failed, saved_bytes, detail = (
                self.result_queue.get_nowait()
            )
        except queue.Empty:
            if self.processing:
                self.root.after(150, self._check_resize_result)
            return

        self.progress.stop()
        self.progress_label.config(text='')
        self.processing = False
        self.scan_button.config(state='normal')
        self.resize_button.config(state='normal')
        self.reset_button.config(state='normal')

        if status == 'success':
            # Update checkbox status for completed items
            for item_id, var in self.video_selectors.items():
                if var.get():
                    self.video_selectors[item_id].set(False)
                    self.list_tree.set(item_id, 'select', ' ')

            saved_mb = saved_bytes / (1024 * 1024)
            self.summary.config(
                text=f'Done! {success} succeeded, {failed} failed. '
                f'Saved {saved_mb:.1f} MB total.\nOutput: {detail}'
            )
            messagebox.showinfo(
                'Complete',
                f'Resized {success} video(s), {failed} failed.\n\n'
                f'Saved {saved_mb:.1f} MB total.\n'
                f'Output: {detail}'
            )
        else:
            self.summary.config(text='Processing failed.')
            messagebox.showerror('Error', f'Batch resize failed:\n{detail}')

    def _find_item_by_path(self, path):
        """Find tree item by video file path."""
        target_name = Path(path).name
        for item in self.list_tree.get_children():
            if self.list_tree.item(item)['text'] == target_name:
                return item
        return None

    def reset(self):
        """Reset everything."""
        self.source_dir.set('')
        self.output_dir.set('')
        self.video_list = []
        self.video_selectors = {}
        self.select_all_var.set(True)
        for item in self.list_tree.get_children():
            self.list_tree.delete(item)
        self.progress_label.config(text='')
        self.progress.stop()
        self.progress['value'] = 0
        self.summary.config(text='')
        self.selected_count.config(text='')

    def _on_close(self):
        if self.processing:
            if not messagebox.askyesno(
                'Processing',
                'A video is still being processed. Close the application anyway?'
            ):
                return
        self.root.destroy()


def main():
    root = tk.Tk()
    VideoResizerApp(root)
    root.mainloop()


if __name__ == '__main__':
    main()
