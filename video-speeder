#!/usr/bin/env python3
"""
Video Speeder - Change video playback speed on Windows, macOS, and Linux.

Original file is never modified. Output written beside it with _speedXX suffix.
Requires Python 3, Tkinter, FFmpeg, and FFprobe.
"""

import os
import queue
import shutil
import subprocess
import threading
import tkinter as tk
from datetime import datetime
from pathlib import Path
from tkinter import messagebox, ttk


VIDEO_EXTENSIONS = {
    '.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv', '.webm',
    '.m4v', '.mpg', '.mpeg', '.3gp', '.ogv', '.ts'
}

SPEEDS = [
    ('25%', 0.25),
    ('50%', 0.50),
    ('75%', 0.75),
    ('125%', 1.25),
    ('150%', 1.50),
    ('175%', 1.75),
    ('200%', 2.00),
]


def find_program(name):
    """Return the executable path, or None if it is not on PATH."""
    return shutil.which(name)


def get_video_duration(filepath):
    """Return video duration in seconds, or 0 if it cannot be read."""
    cmd = [
        find_program('ffprobe') or 'ffprobe',
        '-v', 'error',
        '-show_entries', 'format=duration',
        '-of', 'default=noprint_wrappers=1:nokey=1',
        str(filepath),
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=True, timeout=30
        )
        return float(result.stdout.strip())
    except (subprocess.SubprocessError, ValueError, OSError):
        return 0.0


def has_audio_stream(filepath):
    """Return True if the input contains at least one audio stream."""
    cmd = [
        find_program('ffprobe') or 'ffprobe',
        '-v', 'error',
        '-select_streams', 'a',
        '-show_entries', 'stream=codec_type',
        '-of', 'csv=p=0',
        str(filepath),
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, check=True, timeout=15
        )
        return bool(result.stdout.strip())
    except (subprocess.SubprocessError, OSError):
        return False


def build_atempo_chain(speed):
    """Build an FFmpeg atempo chain; each factor must be between 0.5 and 2."""
    factors = []
    remaining = float(speed)

    while remaining < 0.5:
        factors.append(0.5)
        remaining /= 0.5

    while remaining > 2.0:
        factors.append(2.0)
        remaining /= 2.0

    factors.append(remaining)
    return ','.join(f'atempo={factor:.6f}' for factor in factors)


def speed_video(input_path, output_path, speed):
    """Create a speed-adjusted copy. Does not modify the source file."""
    ffmpeg = find_program('ffmpeg')
    ffprobe = find_program('ffprobe')
    if not ffmpeg or not ffprobe:
        raise RuntimeError(
            'FFmpeg and FFprobe were not found.\n\n'
            'Install FFmpeg and make sure both programs are available in PATH.'
        )

    input_path = str(input_path)
    output_path = str(output_path)

    audio_present = has_audio_stream(input_path)
    video_filter = f'setpts={1.0 / speed:.8f}*PTS'

    cmd = [
        ffmpeg,
        '-hide_banner',
        '-y',
        '-i', input_path,
        '-map', '0:v:0',
    ]

    if audio_present:
        cmd += ['-map', '0:a?']

    cmd += ['-vf', video_filter]

    if audio_present:
        cmd += ['-af', build_atempo_chain(speed)]

    # Fast-start is useful for MP4-family files, but is not supported by
    # every output container.
    if Path(output_path).suffix.lower() in {'.mp4', '.m4v', '.mov'}:
        cmd += ['-movflags', '+faststart']

    cmd += [output_path]

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        details = (result.stderr or result.stdout or 'Unknown FFmpeg error').strip()
        raise RuntimeError(f'FFmpeg could not process this video:\n\n{details[-3000:]}')

    return True


def get_desktop_directory():
    """Return the usual Desktop directory, falling back to the home folder."""
    home = Path.home()
    desktop = home / 'Desktop'
    return desktop if desktop.is_dir() else home


class FileBrowserPanel(ttk.Frame):
    """A simple cross-platform file browser."""

    def __init__(self, parent, on_select=None):
        super().__init__(parent, padding=5)
        self.on_select = on_select
        self.current_dir = Path.home()
        self.item_paths = {}
        self._build_ui()
        self._refresh()

    def _build_ui(self):
        nav = ttk.Frame(self)
        nav.pack(fill='x')

        ttk.Button(nav, text='↑ Up', command=self._go_up, width=6).pack(
            side='left', padx=1
        )
        ttk.Button(nav, text='Home', command=self._go_home, width=6).pack(
            side='left', padx=1
        )
        ttk.Button(
            nav, text='Desktop',
            command=lambda: self._navigate(get_desktop_directory()), width=8
        ).pack(side='left', padx=1)

        self.path_var = tk.StringVar(value=str(self.current_dir))
        ttk.Entry(nav, textvariable=self.path_var).pack(
            side='left', fill='x', expand=True, padx=3
        )
        ttk.Button(nav, text='Go', command=self._go_click, width=4).pack(
            side='left'
        )

        ttk.Label(nav, text='Filter:').pack(side='right', padx=(5, 2))
        self.filter_var = tk.StringVar()
        self.filter_var.trace_add('write', lambda *_: self._refresh())
        ttk.Entry(nav, textvariable=self.filter_var, width=15).pack(side='right')

        quick = ttk.Frame(self)
        quick.pack(fill='x')
        ttk.Label(quick, text='Quick:').pack(side='left')
        for label, folder in (
            ('Home', Path.home()),
            ('Videos', Path.home() / 'Videos'),
            ('Downloads', Path.home() / 'Downloads'),
        ):
            ttk.Button(
                quick, text=label,
                command=lambda p=folder: self._navigate(p), width=9
            ).pack(side='left', padx=1)

        tree_frame = ttk.Frame(self)
        tree_frame.pack(fill='both', expand=True, pady=3)

        vertical = ttk.Scrollbar(tree_frame)
        vertical.pack(side='right', fill='y')
        horizontal = ttk.Scrollbar(tree_frame, orient='horizontal')
        horizontal.pack(side='bottom', fill='x')

        # Include "name" in column #0 (the tree column).
        self.tree = ttk.Treeview(
            tree_frame,
            columns=('size', 'modified'),
            show='headings',
            yscrollcommand=vertical.set,
            xscrollcommand=horizontal.set,
            height=14,
        )
        self.tree.pack(fill='both', expand=True)
        vertical.config(command=self.tree.yview)
        horizontal.config(command=self.tree.xview)

        self.tree.heading('#0', text='Name')
        self.tree.heading('size', text='Size')
        self.tree.heading('modified', text='Modified')
        self.tree.column('#0', width=440, minwidth=180)
        self.tree.column('size', width=100)
        self.tree.column('modified', width=160)

        self.tree.bind('<Double-1>', self._on_double)
        self.tree.bind('<Return>', self._on_double)

        self.status = ttk.Label(self, text='Ready')
        self.status.pack(fill='x', pady=(2, 0))

    def _refresh(self):
        self.tree.delete(*self.tree.get_children())
        self.item_paths.clear()

        if not self.current_dir.is_dir():
            self.current_dir = Path.home()

        self.path_var.set(str(self.current_dir))
        filter_text = self.filter_var.get().strip().casefold()

        try:
            directories = []
            files = []

            with os.scandir(self.current_dir) as entries:
                for entry in entries:
                    if entry.name.startswith('.'):
                        continue
                    if filter_text and filter_text not in entry.name.casefold():
                        continue
                    try:
                        if entry.is_dir(follow_symlinks=False):
                            directories.append(entry)
                        else:
                            files.append(entry)
                    except OSError:
                        continue

            directories.sort(key=lambda item: item.name.casefold())
            files.sort(key=lambda item: item.name.casefold())

            for entry in directories + files:
                path = Path(entry.path)
                is_dir = entry.is_dir(follow_symlinks=False)

                if is_dir:
                    display_name = f'[Folder] {entry.name}'
                    size_text = '—'
                    modified_text = '—'
                else:
                    extension = path.suffix.lower()
                    prefix = '[Video] ' if extension in VIDEO_EXTENSIONS else ''
                    display_name = prefix + entry.name
                    try:
                        stat = entry.stat()
                        size_text = f'{stat.st_size / (1024 * 1024):.1f} MB'
                        modified_text = datetime.fromtimestamp(
                            stat.st_mtime
                        ).strftime('%Y-%m-%d %H:%M')
                    except OSError:
                        size_text = '?'
                        modified_text = '?'

                item_id = self.tree.insert(
                    '', 'end',
                    values=(display_name, size_text, modified_text)
                )
                self.item_paths[item_id] = path

            total = len(directories) + len(files)
            self.status.config(text=f'{total} items  |  {self.current_dir}')

        except (PermissionError, OSError) as error:
            self.status.config(text=f'Cannot read folder: {error}')

    def _on_double(self, _event=None):
        selection = self.tree.selection()
        if not selection:
            return

        path = self.item_paths.get(selection[0])
        if not path:
            return

        if path.is_dir():
            self._navigate(path)
        elif path.suffix.lower() in VIDEO_EXTENSIONS:
            if self.on_select:
                self.on_select(path)

    def _navigate(self, path):
        # expanduser handles typed paths such as ~/Videos on Unix-like systems.
        candidate = Path(os.path.expandvars(os.path.expanduser(str(path))))
        if candidate.is_dir():
            self.current_dir = candidate.resolve()
            self._refresh()
        else:
            messagebox.showwarning(
                'Folder not found', f'This folder does not exist:\n{candidate}'
            )

    def _go_up(self):
        parent = self.current_dir.parent
        if parent != self.current_dir:
            self._navigate(parent)

    def _go_home(self):
        self._navigate(Path.home())

    def _go_click(self):
        value = self.path_var.get().strip()
        if value:
            self._navigate(value)


class VideoSpeederApp:
    def __init__(self, root):
        self.root = root
        self.root.title('Video Speeder')
        self.root.geometry('850x1000')
        self.root.minsize(700, 1000)

        self.input_path = tk.StringVar()
        self.speed_var = tk.StringVar(value='150%')
        self.output_path = tk.StringVar()
        self.processing = False
        self.result_queue = queue.Queue()

        self.speed_var.trace_add('write', self._on_speed_change)
        self._build_ui()
        self._check_dependencies()
        self.root.protocol('WM_DELETE_WINDOW', self._on_close)

    def _check_dependencies(self):
        missing = [
            name for name in ('ffmpeg', 'ffprobe') if not find_program(name)
        ]
        if missing:
            messagebox.showwarning(
                'FFmpeg required',
                'The following required programs were not found:\n\n'
                + '\n'.join(missing)
                + '\n\nInstall FFmpeg and make sure it is available in PATH.'
            )

    def _build_ui(self):
        main = ttk.Frame(self.root, padding=12)
        main.pack(fill='both', expand=True)

        ttk.Label(
            main, text='Video Speeder', font=('TkDefaultFont', 18, 'bold')
        ).pack(pady=(0, 10))

        self.browser = FileBrowserPanel(main, on_select=self._on_video_select)
        self.browser.pack(fill='both', expand=True, pady=(0, 8))

        selected = ttk.LabelFrame(main, text='Selected Video', padding=8)
        selected.pack(fill='x', pady=(0, 8))

        row = ttk.Frame(selected)
        row.pack(fill='x')
        ttk.Label(row, text='Video:').pack(side='left')
        ttk.Entry(
            row, textvariable=self.input_path, state='readonly'
        ).pack(side='left', padx=5, fill='x', expand=True)
        self.info_label = ttk.Label(row, text='')
        self.info_label.pack(side='left', padx=5)

        speed_frame = ttk.LabelFrame(main, text='Speed Setting', padding=8)
        speed_frame.pack(fill='x', pady=(0, 8))
        speed_row = ttk.Frame(speed_frame)
        speed_row.pack(fill='x')

        ttk.Label(speed_row, text='Playback speed:').pack(side='left')
        self.speed_menu = ttk.OptionMenu(
            speed_row, self.speed_var, '150%', *[item[0] for item in SPEEDS]
        )
        self.speed_menu.pack(side='left', padx=5)

        speed_description = '   '.join(
            f'{label} speed = {100 / multiplier:.0f}% of original duration'
            for label, multiplier in SPEEDS
        )
        ttk.Label(
            speed_frame, text=speed_description, wraplength=780
        ).pack(anchor='w', pady=(5, 0))

        output_frame = ttk.LabelFrame(main, text='Output File', padding=8)
        output_frame.pack(fill='x', pady=(0, 8))
        ttk.Entry(
            output_frame, textvariable=self.output_path, state='readonly'
        ).pack(fill='x', expand=True)

        buttons = ttk.Frame(main)
        buttons.pack(fill='x', pady=(8, 0))
        self.start_button = ttk.Button(
            buttons, text='Change Speed', command=self.start_speed
        )
        self.start_button.pack(side='left', expand=True, fill='x', padx=3)
        self.reset_button = ttk.Button(
            buttons, text='Reset', command=self.reset
        )
        self.reset_button.pack(side='left', padx=3)

        progress_frame = ttk.Frame(main)
        progress_frame.pack(fill='x', pady=(8, 0))
        self.progress_label = ttk.Label(progress_frame, text='')
        self.progress_label.pack(fill='x')
        self.progress = ttk.Progressbar(progress_frame, mode='indeterminate')
        self.progress.pack(fill='x')

        self.summary = ttk.Label(main, text='', wraplength=800)
        self.summary.pack(pady=(6, 0))

    def _on_speed_change(self, *_args):
        selected = self.input_path.get()
        if selected and Path(selected).is_file():
            self._update_output_info(Path(selected))

    def _on_video_select(self, path):
        path = Path(path)
        if path.suffix.lower() not in VIDEO_EXTENSIONS:
            messagebox.showwarning(
                'Not a video',
                f'This file type is not supported:\n{path.suffix}'
            )
            return

        self.input_path.set(str(path))
        self._update_output_info(path)

    def _update_output_info(self, path):
        speed_label = self.speed_var.get().replace('%', 'pct')
        output_name = f'{path.stem}_speed{speed_label}{path.suffix}'
        output_path = path.with_name(output_name)
        self.output_path.set(str(output_path))

        duration = get_video_duration(path)
        multiplier = dict(SPEEDS)[self.speed_var.get()]
        if duration > 0:
            self.info_label.config(
                text=f'{duration:.1f}s → {duration / multiplier:.1f}s'
            )
        else:
            self.info_label.config(text='Duration unavailable')

    def start_speed(self):
        if self.processing:
            return

        input_path = Path(self.input_path.get()) if self.input_path.get() else None
        output_path = Path(self.output_path.get()) if self.output_path.get() else None

        if not input_path or not input_path.is_file():
            messagebox.showerror('Select a video', 'Please select a video first.')
            return

        if not find_program('ffmpeg') or not find_program('ffprobe'):
            messagebox.showerror(
                'FFmpeg required',
                'FFmpeg and FFprobe must be installed and available in PATH.'
            )
            return

        speed = dict(SPEEDS)[self.speed_var.get()]

        if output_path.exists():
            if not messagebox.askyesno(
                'Overwrite',
                f'The output file already exists:\n{output_path}\n\nOverwrite it?'
            ):
                return

        if not messagebox.askyesno(
            'Confirm',
            f'Change the playback speed?\n\n'
            f'Input:  {input_path}\n'
            f'Output: {output_path}\n'
            f'Speed:  {self.speed_var.get()}\n\n'
            f'The original file will not be modified.'
        ):
            return

        self.processing = True
        self.start_button.config(state='disabled')
        self.reset_button.config(state='disabled')
        self.speed_menu.config(state='disabled')
        self.progress.start(12)
        self.progress_label.config(text='Processing video…')
        self.summary.config(text='')

        worker = threading.Thread(
            target=self._worker,
            args=(input_path, output_path, speed),
            daemon=True,
        )
        worker.start()
        self.root.after(100, self._check_worker_result)

    def _worker(self, input_path, output_path, speed):
        try:
            speed_video(input_path, output_path, speed)
            self.result_queue.put(('success', str(output_path)))
        except Exception as error:
            self.result_queue.put(('error', str(error)))

    def _check_worker_result(self):
        try:
            status, detail = self.result_queue.get_nowait()
        except queue.Empty:
            if self.processing:
                self.root.after(150, self._check_worker_result)
            return

        self.progress.stop()
        self.progress_label.config(text='')
        self.processing = False
        self.start_button.config(state='normal')
        self.reset_button.config(state='normal')
        self.speed_menu.config(state='normal')

        if status == 'success':
            self.progress_label.config(text='Completed')
            self.summary.config(text=f'Created: {detail}')
            messagebox.showinfo(
                'Complete',
                f'Video speed changed successfully.\n\nOutput:\n{detail}'
            )
        else:
            self.summary.config(text='Processing failed.')
            messagebox.showerror('FFmpeg error', detail)

    def reset(self):
        if self.processing:
            return
        self.input_path.set('')
        self.output_path.set('')
        self.info_label.config(text='')
        self.progress_label.config(text='')
        self.progress.stop()
        self.progress['value'] = 0
        self.summary.config(text='')

    def _on_close(self):
        if self.processing:
            if not messagebox.askyesno(
                'Processing',
                'A video is still being processed. Close the application anyway?'
            ):
                return
        self.root.destroy()


def main():
    root = tk.Tk()
    VideoSpeederApp(root)
    root.mainloop()


if __name__ == '__main__':
    main()
